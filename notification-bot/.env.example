# Токен бота https://t.me/notification_analytics_gh_uz_bot (выдан @BotFather)
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN_FROM_BOTFATHER

# Общий ключ для внутренних API-вызовов между сервисами.
# ДОЛЖЕН совпадать с INTERNAL_API_KEY в auth-service/.env
INTERNAL_API_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# URL auth-service во внутренней docker-сети
AUTH_SERVICE_URL=http://auth-service:80

# production отключает debug-логи gin
ENVIRONMENT=production

# --- Лимиты Telegram Bot API ---
#
# Соблюдаются здесь, а не в вызывающих сервисах: через этого бота шлют и
# notification-service, и auth-service, и цикл ответов на входящие сообщения —
# ни один из них не видит трафик остальных.
#
# Значения по умолчанию равны документированным лимитам Telegram.
# Занижать безопасно, завышать — нет: получим 429 на весь бот.
TELEGRAM_RATE_PER_SECOND=30
TELEGRAM_BURST=30
# Личный чат: 1 сообщение в секунду
TELEGRAM_CHAT_PER_MINUTE=60
TELEGRAM_CHAT_BURST=1
# Группа/супергруппа/канал: 20 сообщений в минуту
TELEGRAM_GROUP_PER_MINUTE=20
TELEGRAM_GROUP_BURST=1
# Сколько бот готов ждать освобождения лимита, прежде чем ответить вызывающему
# 429 + retry_after (тот вернёт сообщение в свою очередь)
TELEGRAM_MAX_WAIT_MS=10000
