# ===================================================================
# СТРАНИЦЫ ОШИБОК ШЛЮЗА
# ===================================================================
# Подключается из gateway.inc внутри server-блока.
#
# Что здесь происходит:
#   1. proxy_intercept_errors on — ответы с кодом 300+ от кого угодно
#      заменяются страницей шлюза. Все страницы ошибок на портале — наши.
#   2. errors-pages.inc — карта «код -> файл», сгенерирована из codes.py.
#   3. location /_errors/ — internal-раздача готовых страниц с включённым SSI.
#   4. errors-preview.inc — витрина всех кодов для администратора.
#
# 403 РИСУЕТСЯ НА МЕСТЕ, А НЕ РЕДИРЕКТОМ.
#
# Раньше error_page 403 вёл на `return 302 /access-denied`, и с включённым
# перехватом это давало цикл: страница /access-denied сама отдаёт 403, шлюз
# снова слал 302 на неё же, браузер крутился до отказа. Теперь error_page
# указывает на статический файл — внутренний редирект, а не ответ клиенту,
# поэтому цепочка обрывается сразу и второго перехода не возникает.
#
# Редирект остался ровно один — 401 на /login. Это не страница ошибки:
# пользователь не получил отказ, он ещё не представился.
#
# ЧТО ПЕРЕХВАТЫВАТЬ НЕЛЬЗЯ (proxy_intercept_errors off в gateway.inc):
#
#   * формы, где не-2xx это контент, а не авария: /login отдаёт 401 вместе
#     с «неверный пароль», /forgot-password и /reset-password отдают 500
#     вместе со страницей результата. Перехват стёр бы сообщение;
#   * JSON-эндпоинты /api/ и /check-user-exists — их читает JS, а не человек;
#   * ассеты: браузеру нужен код ответа, а не страница на несколько килобайт;
#   * подзапросы auth_request: они сами решают, что делать с 401 и 403;
#   * вебсокеты Dozzle.
#
# Побочный эффект перехвата: nginx выбрасывает тело ответа, а разбирать JSON
# он не умеет. Сервис кладёт описание в заголовки X-Error-Code и
# X-Error-Detail — шлюз читает их как $upstream_http_* и показывает в блоке
# «Технические подробности». Ответы 4xx с JSON-телом под префиксом сервиса
# до XHR не доходят; ветка с JSON заготовлена ниже.
# ===================================================================

proxy_intercept_errors on;

# Контакт поддержки для страниц ошибок. Значение приходит из переменной
# окружения SUPPORT_TELEGRAM: docker-entrypoint.sh пишет из неё
# errors-contact.inc с директивой set. Здесь объявляется пустое значение —
# чтобы переменная существовала даже без сгенерированного файла, а SSI не
# спотыкался о неизвестное имя. Порядок важен: include идёт следом и
# перекрывает пустую строку.
set $gw_support_telegram "";
include /etc/nginx/conf.d/errors-contact*.inc;

# limit_req по умолчанию отвечает 503 «сервис недоступен», хотя причина
# другая — превышен лимит частоты. 429 и точнее, и попадает на страницу
# с понятным текстом «подождите минуту».
limit_req_status 429;

# Карта кодов на файлы страниц (сгенерирована error-pages/generate.py).
include /etc/nginx/conf.d/errors-pages.inc;

# ================================================================
# РАЗДАЧА СТРАНИЦ
# ================================================================

# internal: страницы отдаются только по внутреннему редиректу error_page.
# Прямой заход на /_errors/500.html вернёт 404 — иначе ссылку на «красивую
# ошибку» начали бы слать вместо настоящей диагностики.
location ^~ /_errors/ {
    internal;
    alias /usr/share/nginx/html/errors/;
    charset utf-8;

    # SSI включён точечно, только на этой раздаче: включать его глобально
    # значило бы разбирать HTML всех проксируемых страниц портала.
    ssi on;
    ssi_types text/html;

    # add_header в location отменяет наследование серверных заголовков,
    # поэтому защиту приходится перечислить заново. Политика здесь строже
    # общей: ни картинок со стороны, ни форм, ни фреймов.
    # script-src 'self' нужен фону с частицами (/_shared/js/particles.min.js),
    # 'unsafe-inline' — инлайновым скриптам темы, кнопки «Назад» и инициализации.
    add_header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # Страница несёт время, узел и идентификатор запроса — кэшировать нельзя.
    add_header Cache-Control "no-store" always;
}

# Стили страниц ошибок. Отдаются публично и самим nginx: когда лежит
# auth-service, вместе с ним недоступен /static/css/styles.css, а страница
# ошибки обязана выглядеть прилично именно в этот момент.
location = /_errors/errors.css {
    alias /usr/share/nginx/html/errors/errors.css;
    default_type text/css;
    access_log off;
    expires 1h;
    add_header Cache-Control "public, max-age=3600" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# Отсутствующий ассет. Страница для человека в ответ на <script src> или
# <link rel="stylesheet"> — несколько килобайт разметки, которую браузер
# выбросит, не показав. Отдаём пустое тело с тем же кодом.
location @asset_not_found {
    return 404 "";
}

# ================================================================
# ПРЕДПРОСМОТР (только администратор)
# ================================================================
include /etc/nginx/conf.d/errors-preview.inc;

