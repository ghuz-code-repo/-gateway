# Environment variables for notification service
# Copy this file to .env: cp .env.example .env
PORT=80

# --- Service-to-service authentication ---
# Персональные ключи сервисов (формат: name:key,name:key).
# Каждый сервис шлёт свой ключ в заголовке X-API-Key (env NOTIFICATION_API_KEY у клиента).
# При компрометации одного сервиса отзывается только его ключ.
# Генерация: openssl rand -base64 32
SERVICE_API_KEYS=referal:CHANGE_ME,client-service:CHANGE_ME,apartment-finder:CHANGE_ME,monitoring-service:CHANGE_ME,auth-service:CHANGE_ME
# Легаси общий ключ (его уже шлют auth-service и сервисы без NOTIFICATION_API_KEY).
# Должен совпадать с INTERNAL_API_KEY в auth-service.
# Если НИ ОДИН ключ не задан — аутентификация ОТКЛЮЧЕНА (только для переходного периода!)
INTERNAL_API_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# --- Security guard (детектор аномалий, см. security.go) ---
# Окно подсчёта (сек)
GUARD_WINDOW_SECONDS=60
# Лимит запросов от одного сервиса за окно -> при превышении HTTP 429 + алерт
GUARD_MAX_REQUESTS_PER_WINDOW=600
# Лимит невалидных X-API-Key с одного IP за окно -> при превышении бан IP + алерт
GUARD_MAX_INVALID_KEYS_PER_WINDOW=10
# Длительность rate-limit/бана после превышения (сек)
GUARD_THROTTLE_SECONDS=300
# Не слать повторный алерт по тому же источнику чаще, чем раз в N сек
GUARD_ALERT_COOLDOWN_SECONDS=900
# Fallback-получатель алертов, если system_email_recipient не настроен в конфиге
SECURITY_ALERT_EMAIL=d.tolkunov@gh.uz

# Database configuration
DB_HOST=notification-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=notifications
DB_SSLMODE=disable

# SMTP configuration
SMTP_HOST=CHANGE_ME_MAIL_SERVER_IP
SMTP_PORT=587
SMTP_USERNAME=robot@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=robot@example.com
SMTP_USE_TLS=false
SMTP_USE_AUTH=true
SMTP_AUTH_METHOD=login
SMTP_DEBUG=true

# Notification processing settings
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=10
DELAY_BETWEEN_BATCHES_MS=1000
# Пер-канальная задержка между сообщениями (мс). Каналы независимы:
# медленная отправка email НЕ тормозит telegram. 0 = лимит выключен (мгновенно).
DELAY_BETWEEN_MESSAGES_MS=100
TELEGRAM_DELAY_BETWEEN_MESSAGES_MS=0

# Rate limiting settings
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Telegram Configuration
# Все telegram/telegram_system уведомления отправляются через сервис notification-bot
# (единый бот @notification_analytics_gh_uz_bot). Собственные токены больше НЕ нужны.
NOTIFICATION_BOT_URL=http://notification-bot:80
# URL auth-service — резолв получателей (логин портала -> адрес доставки)
# и легаси-резолв telegram username -> chat_id
AUTH_SERVICE_URL=http://auth-service:80

# Соответствие «имя сервиса в SERVICE_API_KEYS = service_key в auth-service».
# Имена расходятся: ключ уведомлений apartment_finder — «apartment-finder»,
# а его service_key в auth-service — «finder». Без маппинга проверка доступа
# в auth-service отвергнет всех получателей этого сервиса.
# Сервисы, которых нет в списке, адресуются своим же именем.
#
# Пустое значение справа = не проверять доступ получателя к сервису. Так задаются
# отправители, которые шлют письма портала в целом, а не своего сервиса: сам
# auth-service (регистрация, сброс пароля) и мониторинг.
SERVICE_AUTH_KEY_MAP=apartment-finder=finder,auth-service=,monitoring-service=

# Включение каналов (можно также через POST /api/v1/config)
TELEGRAM_ENABLED=true
TELEGRAM_SYSTEM_ENABLED=true

# DEPRECATED: прямые токены ботов не используются, оставлены для совместимости конфига
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SYSTEM_BOT_TOKEN=

# System notification recipients
SYSTEM_EMAIL_RECIPIENT=admin@example.com
# Username админа (должен привязать Telegram в личном кабинете портала —
# chat_id резолвится автоматически через auth-service)
SYSTEM_TELEGRAM_USERNAME=@your_telegram

# Toggle system notifications
SEND_SYSTEM_EMAIL_NOTIFICATIONS=true
SEND_SYSTEM_TELEGRAM_NOTIFICATIONS=true
